{
  "title": "Asset Value and Securitization under Heterogeneous Beliefs",
  "author": "Oliver Pardo",
  "source": "main.tex",
  "source_commit": "569840397ac65ab5e8bede250cf86e1ae1d45b8a",
  "source_sha256": "456e825d8efcb4670ad138e9c6c671d55153e094ad91f0c35f90c84563103c48",
